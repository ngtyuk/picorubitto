;
; Standard I2S: WS changes on the falling edge preceding the channel MSB.
; One FIFO word contains left[31:16], right[15:0], shifted MSB first.
; BCLK is side-set bit 0, WS is bit 1. 64 PIO cycles per stereo frame.
.program game_audio_i2s
.side_set 2
.wrap_target
left_bits:
    out pins, 1         side 0b00
    jmp x-- left_bits   side 0b01
    out pins, 1         side 0b10
    set x, 14           side 0b11
right_bits:
    out pins, 1         side 0b10
    jmp x-- right_bits  side 0b11
    out pins, 1         side 0b00
public entry:
    set x, 14           side 0b01
.wrap
